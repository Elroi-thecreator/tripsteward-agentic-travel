{
  "name": "open-agentic-web",
  "version": "1.1.3",
  "description": "Standard developer toolkit, conformance linter & in-browser runtime for the Open Agentic Web (Cognizant / Mozilla / MIT NANDA MVP Profile 0.3)",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "bin": {
    "open-agentic-web": "./bin/cli.mjs",
    "oaw": "./bin/cli.mjs"
  },
  "exports": {
    ".": "./src/index.js",
    "./actions": "./src/actions.js",
    "./validator": "./src/validator.js",
    "./bridge": "./src/bridge.js",
    "./federation": "./src/federation.js"
  },
  "scripts": {
    "test": "node test/validator.test.mjs && node test/actions.test.mjs && node test/federation.test.mjs"
  },
  "keywords": [
    "open-agentic-web",
    "agentic-web",
    "ai-agents",
    "neuro-san",
    "nsdeploy",
    "multi-agent",
    "byok",
    "federation",
    "web-agents",
    "cognizant"
  ],
