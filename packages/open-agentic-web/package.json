  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elroi-thecreator/tripsteward-agentic-travel.git",
    "directory": "packages/open-agentic-web"
  },
  "homepage": "https://github.com/Elroi-thecreator/tripsteward-agentic-travel#readme",
  "bugs": {
    "url": "https://github.com/Elroi-thecreator/tripsteward-agentic-travel/issues"
  },
