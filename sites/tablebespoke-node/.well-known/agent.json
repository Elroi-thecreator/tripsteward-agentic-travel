{
  "$schema": "https://schemas.agent2agent.org/v1/agent-card.json",
  "name": "TableBespoke Fine Dining & Chef's Tables",
  "description": "TableBespoke: Direct fine dining and culinary experience bookings on the Open Agentic Web",
  "url": "http://localhost",
  "version": "0.3.0-v0.3.json",
  "provider": {
    "name": "TableBespoke Fine Dining & Chef's Tables",
    "url": "http://localhost"
  },
  "identity": {
    "brand": "TableBespoke Fine Dining & Chef's Tables",
    "frontMan": "dining_sommelier",
    "category": "Concierge"
  },
  "skills": [
    {
      "id": "check_table_availability",
      "name": "check_table_availability",
      "description": "Check available tasting menus, chef tables, and curated culinary experiences.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cuisine": {
            "type": "string",
            "description": "Preferred cuisine or dietary style."
          },
          "party_size": {
            "type": "integer",
            "description": "Number of dinner guests."
          },
          "time": {
            "type": "string",
            "description": "Desired reservation window."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "effect": "read"
    },
    {
      "id": "reserve_dining_table",
      "name": "reserve_dining_table",
      "description": "Secure and commit a direct culinary reservation with dietary notes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "restaurant_name": {
            "type": "string",
            "description": "Name of restaurant."
          },
          "party_size": {
            "type": "integer",
            "description": "Number of guests."
          },
          "reservation_time": {
            "type": "string",
            "description": "Reservation timestamp."
          },
          "dietary_notes": {
            "type": "string",
            "description": "Allergies or preferences."
          }
        },
        "required": [
          "restaurant_name"
        ],
        "additionalProperties": false
      },
      "effect": "irreversible"
    },
    {
      "id": "query_inventory",
      "name": "query_inventory",
      "description": "Check live provider availability with zero middleman markup.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "effect": "read"
    },
    {
      "id": "commit_reservation",
      "name": "commit_reservation",
      "description": "Confirm and commit a direct provider reservation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          }
        },
        "required": [
          "item_id"
        ],
        "additionalProperties": false
      },
      "effect": "irreversible"
    }
  ],
  "capabilities": {
    "actions": true,
    "pushNotifications": false,
    "tools": [
      "check_table_availability",
      "reserve_dining_table",
      "query_inventory",
      "commit_reservation"
    ],
    "networks": [
      "tablebespoke_concierge"
    ],
    "actionBridgeUrl": "http://localhost/bridge/action-bridge.html"
  },
  "protocols": [
    {
      "name": "nsdeploy-actions-v1",
      "version": "1.0.0",
      "endpoint": "http://localhost/bridge/action-bridge.html"
    }
  ],
  "authentication": {
    "type": "byok",
    "description": "Bring Your Own Key client-side inference"
  }
}